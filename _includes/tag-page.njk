---
layout: base.njk
pagination:
  data: topicTags
  size: 1
  alias: tag
permalink: "/tags/{{ tag }}/"
---

{% set posts = collections[tag] %}

# {{ tag | replace("-", " ") | title }}

{% if posts and posts.length %}
<ul>
  {% for post in posts %}
    <li>
      <a href="{{ post.url }}">{{ post.data.title }}</a>
      {% if post.date %} — {{ post.date | readableDate }}{% endif %}
    </li>
  {% endfor %}
</ul>
{% else %}
<p>No posts found for this topic.</p>
{% endif %}

