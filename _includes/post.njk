---
layout: base.njk
---

<article class="blog-post" data-pagefind-body>

  <header class="post-header">

    <h1 class="post-title" data-pagefind-meta="title">
      {{ title or page.fileSlug }}
    </h1>

    {% if description %}
      <p class="post-subtitle">
        {{ description }}
      </p>
    {% endif %}

    {% if date %}
      <p class="post-meta">
        Published {{ date | readableDate }}
        {% if updated %}
          • Updated {{ updated | readableDate }}
        {% endif %}
      </p>
    {% endif %}

    {% if tags and tags.length %}
      <div class="post-tags">
        {% for tag in tags %}
          {% if tag != "posts" and tag != "all" and tag != "nav" %}
            <a class="tag" href="/tags/{{ tag | slug }}/">
              {{ tag | replace("-", " ") }}
            </a>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    <div class="share">
      <span class="share-label">Share:</span>

      <a class="share-btn"
         href="https://www.linkedin.com/sharing/share-offsite/?url={{ (site.url ~ page.url) | urlencode }}"
         target="_blank" rel="noopener">
        LinkedIn
      </a>

      <a class="share-btn"
         href="https://twitter.com/intent/tweet?url={{ (site.url ~ page.url) | urlencode }}&text={{ title | urlencode }}"
         target="_blank" rel="noopener">
        X
      </a>

      <a class="share-btn"
         href="https://wa.me/?text={{ (title ~ ' ' ~ site.url ~ page.url) | urlencode }}"
         target="_blank" rel="noopener">
        WhatsApp
      </a>
    </div>

  </header>

  {% if featuredImage %}
    <img 
      src="{{ featuredImage }}" 
      alt="{{ featuredImageAlt or title }}" 
      class="post-featured-image"
      data-pagefind-meta="image[src], image_alt[alt]">
  {% endif %}

  <div class="post-content">
    {{ content | safe }}
  </div>

  <!-- ✅ Recommended Articles (ADDED HERE) -->
  {% if tags %}
<section class="recommended-posts">

  <h3>Recommended Articles</h3>

  <div class="recommended-grid">

    {% set currentPost = page.url %}
    {% set recommendations = [] %}
    {% set selectedUrls = [] %}

    {# STEP 1: Find tag-based matches #}
    {% for post in collections.posts %}

      {% if post.url != currentPost %}

        {% set matchCount = 0 %}

        {% for tag in tags %}
          {% if tag in post.data.tags %}
            {% set matchCount = matchCount + 1 %}
          {% endif %}
        {% endfor %}

        {% if matchCount > 0 %}
          {% set recommendations = recommendations.concat([{
            "post": post,
            "score": matchCount
          }]) %}
        {% endif %}

      {% endif %}

    {% endfor %}

    {# STEP 2: Sort by relevance #}
    {% set recommendations = recommendations | sort(attribute="score") | reverse %}

    {# STEP 3: Take top matches first #}
    {% set finalPosts = [] %}

    {% for item in recommendations %}
      {% if finalPosts.length < 3 %}
        {% set finalPosts = finalPosts.concat([item.post]) %}
        {% set selectedUrls = selectedUrls.concat([item.post.url]) %}
      {% endif %}
    {% endfor %}

    {# STEP 4: Fallback → latest posts if needed #}
    {% if finalPosts.length < 3 %}
  {% for post in collections.posts | reverse %}
    {% if finalPosts.length < 3 %}
      {% if post.url != currentPost and (post.url not in selectedUrls) %}
        
        {% set finalPosts = finalPosts.concat([post]) %}
        {% set selectedUrls = selectedUrls.concat([post.url]) %}

      {% endif %}
    {% endif %}
  {% endfor %}
{% endif %}

    {# STEP 5: Render #}
    {% for post in finalPosts %}
      <a href="{{ post.url }}" class="recommended-card">
        <h4>{{ post.data.title }}</h4>
        {% if post.data.description %}
          <p>{{ post.data.description }}</p>
        {% endif %}
      </a>
    {% endfor %}

  </div>

</section>
{% endif %}
  <!-- ✅ End Recommended -->

  <div class="post-extras">
    <div class="subscribe-inline">
      {% include "subscribe.njk" %}
    </div>

    <hr>

    <div class="comments-section">
      <h3>Comments</h3>

     <p class="comment-note">
  Join the discussion below (GitHub login required), or share your thoughts on 
  <a href="https://www.linkedin.com/in/tarun-gupta-3a0082141/" target="_blank" rel="noopener">
    LinkedIn
  </a>. I’m most active there.
</p>

      <script src="https://giscus.app/client.js"
        data-repo="Tarun-Gup/Analyst-in-Action"
        data-repo-id="R_kgDOQv_RYQ"
        data-category="Announcements"
        data-category-id="DIC_kwDOQv_RYc4C3WqG"
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="bottom"
        data-theme="light"
        data-lang="en"
        crossorigin="anonymous"
        async>
      </script>
    </div>
  </div>

</article>