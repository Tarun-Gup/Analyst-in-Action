---
layout: base.njk
---

<article class="blog-post">

  <header class="post-header">

    <h1 class="post-title">
      {{ title or page.fileSlug }}
    </h1>

    {% if description %}
      <p class="post-subtitle">
        {{ description }}
      </p>
    {% endif %}

    {% if date %}
      <p class="post-meta">
        Published {{ date | readableDate }}
        {% if updated %}
          • Updated {{ updated | readableDate }}
        {% endif %}
      </p>
    {% endif %}

    {% if tags and tags.length %}
      <div class="post-tags">
        {% for tag in tags %}
          {% if tag != "posts" and tag != "all" and tag != "nav" %}
            <a class="tag" href="/tags/{{ tag | slug }}/">
              {{ tag | replace("-", " ") }}
            </a>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    <!-- Share Buttons -->
    <div class="share">
      <span class="share-label">Share:</span>

      <a class="share-btn"
         href="https://www.linkedin.com/sharing/share-offsite/?url={{ (site.url ~ page.url) | urlencode }}"
         target="_blank" rel="noopener">
        LinkedIn
      </a>

      <a class="share-btn"
         href="https://twitter.com/intent/tweet?url={{ (site.url ~ page.url) | urlencode }}&text={{ title | urlencode }}"
         target="_blank" rel="noopener">
        X
      </a>

      <a class="share-btn"
         href="https://wa.me/?text={{ (title ~ ' ' ~ site.url ~ page.url) | urlencode }}"
         target="_blank" rel="noopener">
        WhatsApp
      </a>
    </div>

  </header>

  <div class="post-content">
    {{ content | safe }}
  </div>

</article>














