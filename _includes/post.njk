---
layout: base.njk
---

<article class="blog-post">

  <header class="post-header">

    <h1 class="post-title">
      {{ title or page.fileSlug }}
    </h1>

    {% if description %}
      <p class="post-subtitle">
        {{ description }}
      </p>
    {% endif %}

    {% if date %}
      <p class="post-meta">
        Published {{ date | readableDate }}
        {% if updated %}
          • Updated {{ updated | readableDate }}
        {% endif %}
      </p>
    {% endif %}

    {% if tags and tags.length %}
      <div class="post-tags">
        {% for tag in tags %}
          {% if tag != "posts" and tag != "all" and tag != "nav" %}
            <a class="tag" href="/tags/{{ tag | slug }}/">
              {{ tag | replace("-", " ") }}
            </a>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    <!-- Share Buttons -->
    <div class="share">
      <span class="share-label">Share:</span>

      <a class="share-btn"
         href="https://www.linkedin.com/sharing/share-offsite/?url={{ (site.url ~ page.url) | urlencode }}"
         target="_blank" rel="noopener">
        LinkedIn
      </a>

      <a class="share-btn"
         href="https://twitter.com/intent/tweet?url={{ (site.url ~ page.url) | urlencode }}&text={{ title | urlencode }}"
         target="_blank" rel="noopener">
        X
      </a>

      <a class="share-btn"
         href="https://wa.me/?text={{ (title ~ ' ' ~ site.url ~ page.url) | urlencode }}"
         target="_blank" rel="noopener">
        WhatsApp
      </a>
    </div>

  </header>

  <!-- Featured Image -->
  {% if featuredImage %}
    <img 
      src="{{ featuredImage }}" 
      alt="{{ featuredImageAlt or title }}" 
      class="post-featured-image">
  {% endif %}

  <div class="post-content">
    {{ content | safe }}

    <!-- SUBSCRIBE (inline, clean card) -->
    <div class="subscribe-inline">
      {% include "subscribe.njk" %}
    </div>

    <hr>

    <div class="comments-section">
      <h3>Comments</h3>

      <p class="comment-note">
        Prefer not to sign in? Share your thoughts on
        <a href="https://www.linkedin.com/in/tarun-gupta-3a0082141/" target="_blank" rel="noopener">
          LinkedIn
        </a>
        I reply fastest there.
      </p>

      <script src="https://giscus.app/client.js"
        data-repo="Tarun-Gup/Analyst-in-Action"
        data-repo-id="R_kgDOQv_RYQ"
        data-category="Announcements"
        data-category-id="DIC_kwDOQv_RYc4C3WqG"
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="bottom"
        data-theme="light"
        data-lang="en"
        crossorigin="anonymous"
        async>
      </script>

    </div>

  </div>

</article>













