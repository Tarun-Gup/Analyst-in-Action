<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <title>
    {% if title %}
      {{ title }} | Analyst in Action
    {% else %}
      Analyst in Action
    {% endif %}
  </title>

  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  {% if description %}
    <meta name="description" content="{{ description }}">
  {% else %}
    <meta name="description" content="Practical insights on Power BI, DAX, data modeling, and real-world Business Intelligence projects.">
  {% endif %}

  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <meta property="og:title" content="{% if title %}{{ title }} | Analyst in Action{% else %}Analyst in Action{% endif %}">
  <meta property="og:type" content="article">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:description" content="{% if description %}{{ description }}{% else %}Practical insights on Power BI, DAX, data modeling, and real-world Business Intelligence projects.{% endif %}">
  <meta property="og:site_name" content="Analyst in Action">
  <meta property="og:image" content="{{ site.url }}/assets/images/og.jpg">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{% if title %}{{ title }} | Analyst in Action{% else %}Analyst in Action{% endif %}">
  <meta name="twitter:description" content="{% if description %}{{ description }}{% else %}Practical insights on Power BI, DAX, data modeling, and real-world Business Intelligence projects.{% endif %}">
  <meta name="twitter:image" content="{{ site.url }}/assets/images/og.jpg">

  <link rel="icon" href="/assets/favicon.ico">
  <link rel="stylesheet" href="/style.css">

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-M2K1TEG6BM"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-M2K1TEG6BM');
  </script>
</head>

<body>

  <header class="hero">
    
    {% include "nav.njk" %}

    <div class="hero-content">
      <h1>Power BI, built for real-world use.</h1>
      <p>
        Lessons from actual reports, data models, and business problems.
      </p>
    </div>

  </header>

  <main class="layout-full">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="footer-links">
      <div class="footer-main">
        <a href="/blog/">Blog</a>
        <a href="/start-here/">Start Here</a>
        <a href="/training/">Learn Power BI</a>
        <a href="/about/">About</a>
        <a href="/contact/">Contact</a>
      </div>

      <div class="footer-legal">
        <a href="/privacy/">Privacy Policy</a>
        <a href="/terms/">Terms of Use</a>
      </div>
    </div>

    <p class="footer-copy">
      © 2026 Analyst in Action. All rights reserved.
    </p>
  </footer>

  <!-- ✅ FIXED MOBILE MENU SCRIPT -->
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const toggle = document.querySelector(".menu-toggle");
      const navLinks = document.querySelector(".nav-links");

      if (toggle && navLinks) {
        toggle.addEventListener("click", () => {
          navLinks.classList.toggle("open");

          const isOpen = navLinks.classList.contains("open");
          toggle.setAttribute("aria-expanded", isOpen);
        });
      }
    });
  </script>

</body>
</html>
