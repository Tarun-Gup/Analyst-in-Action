---
layout: base.njk
title: Blog
pagination:
  data: collections.posts
  size: 9
  alias: posts
---

<section class="blog-categories-wrap">
  <h2>Browse by Category</h2>
  <div class="blog-categories-list">
    <a class="blog-category-pill" href="/blog/">All</a>

    {% for tag in topicTags %}
      <a class="blog-category-pill" href="/tags/{{ tag }}/">
        {{ tag | tagLabel }}
      </a>
    {% endfor %}
  </div>
</section>

<section class="blog-search-wrap">
  {% include "searchbar.njk" %}
</section>

<div class="post-grid">
  {% for post in posts %}
    <article class="post-card" data-pagefind-ignore="all">

      {% if post.data.featuredImage %}
        <a href="{{ post.url }}">
          <img
            class="post-card-image"
            src="{{ post.data.featuredImage }}"
            alt="{{ post.data.title }}">
        </a>
      {% endif %}

      <p class="post-date">
        {{ post.date | readableDate }}
      </p>

      <h3>
        <a href="{{ post.url }}">
          {{ post.data.title }}
        </a>
      </h3>

      <div class="post-tags">
        {% for tag in post.data.tags %}
          {% if topicTags.includes(tag) %}
            <a class="tag" href="/tags/{{ tag }}/">
              {{ tag | tagLabel }}
            </a>
          {% endif %}
        {% endfor %}
      </div>

      {% if post.data.description %}
        <p class="post-desc">
          {{ post.data.description }}
        </p>
      {% endif %}

      <a class="read-more" href="{{ post.url }}">
        Read More →
      </a>

    </article>
  {% endfor %}
</div>

{% if pagination.pages.length > 1 %}
  <div class="pagination">
    {% if pagination.href.previous %}
      <a href="{{ pagination.href.previous }}">← Previous</a>
    {% endif %}

    <span>Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}</span>

    {% if pagination.href.next %}
      <a href="{{ pagination.href.next }}">Next →</a>
    {% endif %}
  </div>
{% endif %}