---
layout: base.njk
title: Home
hero: home
---


<section class="homepage-intro">
  <h2>Latest Power BI & Data Insights</h2>
  <p>Real-world lessons from actual Power BI projects.</p>
</section>

{% if collections.posts and (collections.posts | length) > 0 %}

  <div class="post-grid">
    {% for post in collections.posts %}
      {% if loop.index0 < 6 %}

        <article class="post-card">

          <p class="post-date">
            {{ post.date | readableDate }}
          </p>

          <h3 class="post-title">
            <a href="{{ post.url }}">{{ post.data.title or "Untitled" }}</a>
          </h3>

          {% if post.data.description %}
            <p class="post-desc">
              {{ post.data.description }}
            </p>
          {% endif %}

          <a class="read-more" href="{{ post.url }}">Read More →</a>

        </article>

      {% endif %}
    {% endfor %}
  </div>

  <div class="homepage-more">
    <a class="button" href="/blog/">View all posts →</a>
  </div>

{% else %}

  <p>No posts found yet.</p>

{% endif %}




