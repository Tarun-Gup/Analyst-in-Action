---
layout: base.njk
title: Home
---

<section class="homepage-intro">
  <h2>Latest Power BI & Data Insights</h2>
  <p>Real-world lessons from actual Power BI projects.</p>
</section>

{% if collections.posts | length %}

<div class="post-grid">
  {% for post in (collections.posts | reverse) %}
    {% if loop.index0 < 6 %}
      <article class="post-card">
        <h3 class="post-title">
          <a href="{{ post.url }}">{{ post.data.title or "Untitled" }}</a>
        </h3>

        {% if post.date %}
          <p class="post-date">{{ post.date | readableDate }}</p>
        {% endif %}

        <p class="post-desc">
          {{ post.data.description or "" }}
        </p>

        <a class="read-more" href="{{ post.url }}">Read more →</a>
      </article>
    {% endif %}
  {% endfor %}
</div>

<div class="homepage-more">
  <a class="button" href="/blog/">View all posts →</a>
</div>

{% else %}

<p>No posts found yet.</p>

{% endif %}
